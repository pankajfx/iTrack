# ITrack environment template. Copy to .env and fill in real values.
# This file is committed to git: NEVER put real secrets in it.

# MongoDB (database name comes from the URI path). Production: create a dedicated
# user and enable authentication - see PROJECT_GUIDE section 9.
MONGO_URI=mongodb://localhost:27017/sdwan_tracker
# MONGO_URI=mongodb://<app-user>:<strong-password>@localhost:27017/sdwan_tracker?authSource=admin

# Signs the session cookie. At least 32 random characters; the app refuses to
# start without one unless FLASK_DEBUG=true. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# /admin user-management panel. At least 12 characters and not a common
# password, or the panel stays disabled.
ADMIN_PASSWORD=

REALTIME_MODE=hybrid
SOCKET_TIMEOUT=2000
SOCKET_INCLUDE_FULL_DATA=true
PORT=5001
FLASK_DEBUG=false

# Development runs the threading server. Production runs gevent, behind Caddy or
# Nginx on the same host - see PROJECT_GUIDE section 9 for every setting:
# SOCKETIO_ASYNC_MODE=gevent
# TRUST_PROXY_HOPS=1            # one reverse proxy in front; also binds 127.0.0.1
# SESSION_COOKIE_SECURE=true
# HSTS_MAX_AGE=31536000         # only with a trusted certificate on a stable name
# PUBLIC_ORIGINS=https://itrack.example.com   # when the public name differs from the Host the app sees
